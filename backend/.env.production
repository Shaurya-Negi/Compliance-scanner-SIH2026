# SIH26034 Backend Production Environment Configuration
APP_ENV=production
PORT=8000
HOST=0.0.0.0

# Render Managed PostgreSQL Connection String
DATABASE_URL=postgresql://sih_admin:password@dpg-xxxx.oregon-postgres.render.com/sih2026

# Groq Cloud API Key (Get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# JWT Authentication (Generate a secure 64-char key in production)
JWT_SECRET_KEY=generate_a_random_64_character_hex_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Include your Vercel deployment URL)
CORS_ORIGINS=https://sih2026-scanner.vercel.app,http://localhost:5173

# Storage directories
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_SIZE_MB=10
